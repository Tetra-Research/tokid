{
  "profileId": "openai-cross-v1",
  "default": true,
  "outputFile": "openai-cross-v1.generated.ts",
  "profileVersion": 1,
  "profileTag": "oa1",
  "name": "OpenAI Cross v1",
  "description": "OpenAI-derived token-native profile compiled from shared single-token, pronounceable word atoms with prefix-free transport decoding.",
  "provider": "openai",
  "vocabulary": {
    "syntax": "^[a-z]+$"
  },
  "entropy": {
    "recommendedLength": 8
  },
  "candidateSource": {
    "path": "study/wordfreq-atom-ranking/results/scored_candidates.csv",
    "wordColumn": "word",
    "filters": [
      {
        "column": "shared_single_token",
        "equals": "true",
        "label": "shared_single_token == true"
      },
      {
        "column": "pronounceable",
        "equals": "true",
        "label": "pronounceable == true"
      },
      {
        "column": "rank",
        "max": 8192,
        "label": "rank <= 8192"
      },
      {
        "column": "composite_score",
        "min": 80,
        "label": "composite_score >= 80"
      },
      {
        "column": "char_length",
        "min": 5,
        "max": 8,
        "label": "5 <= word.length <= 8"
      }
    ],
    "sort": [
      {
        "column": "composite_score",
        "type": "number",
        "direction": "desc"
      },
      {
        "column": "rank",
        "type": "number",
        "direction": "asc"
      },
      {
        "column": "word",
        "type": "string",
        "direction": "asc"
      }
    ],
    "sortLabel": "composite_score desc, rank asc, word asc sort",
    "reduction": {
      "type": "prefix-free",
      "label": "greedy prefix-free reduction for delimiterless transport decodability"
    }
  },
  "transportEvidence": {
    "path": "study/transport-contexts/results/transport_safe_winners.csv",
    "expectedWinner": "none",
    "expectedRunnerUp": "underscore"
  },
  "sourceLineage": {
    "studies": [
      "study/token-atom-scoring",
      "study/wordfreq-atom-ranking",
      "study/separator-effects",
      "study/transport-contexts"
    ],
    "notes": [
      "Prompt payload prefers literal spaces.",
      "Transport payload prefers delimiterless concatenation for OpenAI tokenizers."
    ]
  },
  "codecs": [
    {
      "id": "prompt",
      "kind": "payload",
      "description": "Bare prompt payload with atoms joined by literal spaces.",
      "separator": " ",
      "normalization": "whitespace",
      "transportSafe": false,
      "decodability": {
        "mode": "separator"
      }
    },
    {
      "id": "transport",
      "kind": "payload",
      "description": "Bare transport payload using delimiterless atom concatenation.",
      "separator": "",
      "normalization": "literal",
      "transportSafe": true,
      "decodability": {
        "mode": "prefix-free"
      }
    },
    {
      "id": "envelope",
      "kind": "envelope",
      "description": "Durable transport envelope with explicit profile and checksum metadata.",
      "payloadCodecId": "transport",
      "prefix": "tk1",
      "separator": "_",
      "formatVersion": 1,
      "checksum": {
        "algorithm": "sha256-base36",
        "length": 5
      }
    }
  ]
}
