{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist/dev",
    "rootDir": ".",
    "declaration": true
  },
  "include": [
    "packages/js/src/**/*.ts",
    "packages/js/test/**/*.ts",
    "study/**/*.ts"
  ]
}
